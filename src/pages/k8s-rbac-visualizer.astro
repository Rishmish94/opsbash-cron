---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'How does Kubernetes resolve effective RBAC permissions?',
    a: 'Kubernetes RBAC is purely additive. There is no deny rule at the RBAC layer. Every RoleBinding and ClusterRoleBinding that names a subject grants whatever rules its roleRef contains, and a subject\'s effective permissions are simply the union of every rule granted by every binding that applies to it. Nothing can be subtracted, only added.',
  },
  {
    q: 'Does a RoleBinding to a ClusterRole grant cluster-wide access?',
    a: 'No — this is the single most common RBAC misunderstanding. A RoleBinding always scopes the rules it grants to its own namespace, even when its roleRef points to a ClusterRole. Binding a ClusterRole via a RoleBinding is a normal, supported pattern for reusing a rule set across many namespaces without granting anything cluster-wide. Only a ClusterRoleBinding grants access across every namespace.',
  },
  {
    q: 'What is an aggregated ClusterRole?',
    a: 'An aggregated ClusterRole has an aggregationRule.clusterRoleSelectors field with label selectors instead of (or in addition to) its own rules. The Kubernetes control plane watches for any other ClusterRole whose metadata.labels match those selectors and automatically merges that ClusterRole\'s rules into the aggregating one. This lets add-ons and operators extend built-in roles like admin or edit by simply labeling their own ClusterRole, without editing the original object.',
  },
  {
    q: 'Is my pasted YAML sent to a server?',
    a: 'No. Parsing, resolution, and rendering all happen in your browser with JavaScript. Nothing you paste is uploaded anywhere. The only network activity this tool ever creates is if you click Copy shareable link, which encodes your input into the URL itself so it can be pasted and shared — it still never touches a server.',
  },
  {
    q: 'What is the difference between a Role and a ClusterRole?',
    a: 'A Role\'s rules only ever apply within the single namespace it is defined in, and it can only be bound with a RoleBinding in that same namespace. A ClusterRole is not namespaced — it can be bound cluster-wide with a ClusterRoleBinding, or bound to a single namespace with a RoleBinding (see the previous question). ClusterRoles are also required for cluster-scoped resources like nodes or persistentvolumes, since those have no namespace to scope a Role to.',
  },
  {
    q: 'Can Kubernetes RBAC explicitly deny a permission?',
    a: 'No. Native Kubernetes RBAC has no deny rules, no negation, and no priority ordering between bindings. If any binding grants a permission to a subject, that subject has it, full stop, regardless of how many other bindings exist. Explicit deny requires a separate admission control layer such as a ValidatingAdmissionPolicy, OPA Gatekeeper, or Kyverno policy — RBAC itself is additive-only by design.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Kubernetes RBAC Effective Permissions Visualizer",
  "url": "https://opsbash.com/k8s-rbac-visualizer",
  "description": "Paste Role, ClusterRole, RoleBinding and ClusterRoleBinding YAML and instantly see every subject's effective permissions, resolved correctly across namespace scoping and aggregated ClusterRoles. Runs entirely in your browser, with shareable permalinks.",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
};
---

<Layout
  title="Kubernetes RBAC Visualizer — Effective Permissions from Role & Binding YAML | OpsBash"
  description="Paste Role, ClusterRole, RoleBinding and ClusterRoleBinding YAML and see exactly what each subject can do — resolved correctly for namespace-scoped ClusterRole bindings and aggregated ClusterRoles. Free, client-side, with shareable permalinks."
  canonicalURL="https://opsbash.com/k8s-rbac-visualizer"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />

<div style="background: var(--bg);">
<div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="pt-8 pb-5">
    <span class="k8s-cat-pill">Kubernetes</span>
    <h1 class="text-3xl sm:text-4xl font-bold mt-4 mb-3 tracking-tight" style="color: #F8FAFC;">
      RBAC Effective Permissions Visualizer
    </h1>
    <p class="text-base max-w-2xl mb-5" style="color: var(--fg2);">
      Paste any combination of Role, ClusterRole, RoleBinding and ClusterRoleBinding YAML. This tool resolves the effective, additive permissions for every subject, and shows exactly which binding granted each one — including correct namespace scoping for RoleBinding-to-ClusterRole and resolved aggregated ClusterRoles.
    </p>
    <p class="security-line">Everything runs in your browser. Your manifests are never uploaded anywhere.</p>
  </section>

  <!-- ── INPUT CARD ───────────────────────────────────────────────────────── -->
  <div class="rounded-[14px] mb-6 overflow-hidden" style="background: var(--card); border: 1px solid var(--border);">
    <div class="px-5 py-4 flex items-center justify-between flex-wrap gap-2" style="border-bottom: 1px solid var(--border); background: var(--bg);">
      <h2 class="text-xs font-semibold uppercase tracking-wider" style="color: var(--fg2);">Paste RBAC YAML (multi-document, --- separated)</h2>
      <button id="loadExampleBtn" class="btn-secondary">Load example</button>
    </div>
    <div class="p-5">
      <textarea id="rbacInput" class="k8s-textarea" spellcheck="false" autocomplete="off"
        placeholder={`apiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: pod-reader\n  namespace: staging\nrules:\n  - apiGroups: [""]\n    resources: ["pods"]\n    verbs: ["get", "list", "watch"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: pod-reader-binding\n  namespace: staging\nsubjects:\n  - kind: ServiceAccount\n    name: staging-app\n    namespace: staging\nroleRef:\n  kind: Role\n  name: pod-reader\n  apiGroup: rbac.authorization.k8s.io`}></textarea>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button id="visualizeBtn" class="btn-primary">Visualize</button>
        <button id="copyLinkBtn" class="btn-secondary">Copy shareable link</button>
      </div>
      <div id="rbacError" class="err-box mt-3 hidden"></div>
      <div id="rbacWarning" class="warn-box mt-3 hidden"></div>
    </div>
  </div>

  <!-- ── RESULTS CARD ─────────────────────────────────────────────────────── -->
  <div id="resultsCard" class="rounded-[14px] mb-10 overflow-hidden hidden" style="background: var(--card); border: 1px solid var(--border);">
    <div class="px-5 py-4" style="border-bottom: 1px solid var(--border); background: var(--bg);">
      <h2 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--fg2);">Effective Permissions by Subject</h2>
      <input id="subjectSearch" type="text" class="k8s-input" spellcheck="false" autocomplete="off" placeholder="Filter by subject name or kind…" />
    </div>
    <div id="resultsBody" class="subject-list"></div>
    <div id="noResults" class="p-5 text-sm hidden" style="color: var(--fg2);">No subjects match your filter.</div>
  </div>

  <!-- ── SECTION: ADDITIVE MODEL ─────────────────────────────────────────── -->
  <section class="mb-6">
    <div class="overflow-hidden rounded-[14px]" style="background: var(--card); border: 1px solid var(--border);">
      <div class="p-5" style="border-bottom: 1px solid var(--border); background: var(--bg);">
        <h2 class="text-base font-semibold" style="color: var(--fg);">RBAC Is Purely Additive — There Is No Deny Rule</h2>
      </div>
      <div class="p-5">
        <p class="seo-p">Kubernetes RBAC has exactly one operation: grant. A subject's effective permission for any (namespace, resource, verb) combination is the union of every rule granted by every RoleBinding or ClusterRoleBinding that names that subject. There is no explicit deny, no rule priority, and no way for one binding to override or subtract from another. If any single binding grants <code class="ic">delete</code> on <code class="ic">pods</code>, that subject can delete pods, even if ten other bindings say nothing about pods at all. This tool implements exactly that: it never treats a missing rule as a deny, only ever as "not yet granted," and it unions every applicable rule from every binding you paste in.</p>
      </div>
    </div>
  </section>

  <!-- ── SECTION: GOTCHA A ────────────────────────────────────────────────── -->
  <section class="mb-6">
    <div class="overflow-hidden rounded-[14px]" style="background: var(--card); border: 1px solid var(--border);">
      <div class="p-5" style="border-bottom: 1px solid var(--border); background: var(--bg);">
        <h2 class="text-base font-semibold" style="color: var(--fg);">Gotcha: A RoleBinding to a ClusterRole Is Still Namespace-Scoped</h2>
      </div>
      <div class="p-5">
        <p class="seo-p">It is completely normal, and common, to bind a ClusterRole using a RoleBinding rather than a ClusterRoleBinding — this is the standard way to reuse one rule set (like a built-in <code class="ic">edit</code> or <code class="ic">view</code> ClusterRole) across many namespaces without duplicating YAML. The part that trips engineers up is what scope that grants: <strong style="color: var(--fg);">a RoleBinding always scopes whatever it grants to its own namespace, regardless of whether roleRef points to a Role or a ClusterRole.</strong> Binding the cluster-admin ClusterRole via a RoleBinding in the <code class="ic">staging</code> namespace grants admin rights inside <code class="ic">staging</code> only, not cluster-wide. Only a ClusterRoleBinding grants access across every namespace. This tool resolves that scoping correctly and flags it inline wherever it applies.</p>
      </div>
    </div>
  </section>

  <!-- ── SECTION: GOTCHA B ────────────────────────────────────────────────── -->
  <section class="mb-10">
    <div class="overflow-hidden rounded-[14px]" style="background: var(--card); border: 1px solid var(--border);">
      <div class="p-5" style="border-bottom: 1px solid var(--border); background: var(--bg);">
        <h2 class="text-base font-semibold" style="color: var(--fg);">Gotcha: Aggregated ClusterRoles Merge Rules From Elsewhere</h2>
      </div>
      <div class="p-5">
        <p class="seo-p">A ClusterRole can define <code class="ic">aggregationRule.clusterRoleSelectors</code> instead of (or alongside) its own <code class="ic">rules</code>. The control plane continuously scans for any other ClusterRole whose <code class="ic">metadata.labels</code> match those selectors and merges that role's rules in automatically — this is exactly how add-ons extend the built-in <code class="ic">admin</code> and <code class="ic">edit</code> ClusterRoles without anyone editing them directly. Reading an aggregating ClusterRole's own YAML in isolation is misleading: its real, effective permissions live partly in whatever ClusterRoles elsewhere in the cluster happen to carry the matching label. This tool resolves aggregation across everything you paste, in any order, and clearly warns you when a selector matches nothing in your input so you know the picture may be incomplete.</p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────────── -->
  <section class="mb-6">
    <div class="overflow-hidden rounded-[14px]" style="background: var(--card); border: 1px solid var(--border);">
      <div class="p-5" style="border-bottom: 1px solid var(--border); background: var(--bg);">
        <h2 class="text-base font-semibold" style="color: var(--fg);">Frequently Asked Questions</h2>
      </div>
      {faqs.map((faq, i) => (
        <div class="faq-item" style={i === faqs.length - 1 ? 'border-bottom: none;' : ''}>
          <button class="faq-trigger w-full flex items-center justify-between p-5 text-left gap-3">
            <span class="text-sm font-medium" style="color: var(--fg);">{faq.q}</span>
            <svg class="faq-chevron w-4 h-4 shrink-0 transition-transform duration-200" style="color: var(--fg3);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-content hidden px-5 pb-5 text-sm leading-relaxed" style="color: var(--fg2);">
            {faq.a}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── RELATED TOOLS ────────────────────────────────────────────────────── -->
  <section class="pb-16">
    <div class="related-card">
      <h2 class="section-title" style="margin-bottom: 14px;">Related Tools</h2>
      <div class="related-grid">
        <a href="/k8s-secret-decoder" class="related-item">
          <div>
            <p class="related-name">Kubernetes Secret Decoder</p>
            <p class="related-desc">Decode Kubernetes Secret YAML and reveal base64 encoded values</p>
          </div>
          <span class="related-arrow">→</span>
        </a>
        <a href="/cheatsheets/kubernetes" class="related-item">
          <div>
            <p class="related-name">Kubernetes Cheat Sheet</p>
            <p class="related-desc">Command reference for pods, deployments, debugging, and cluster management</p>
          </div>
          <span class="related-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

</div>
</div>

