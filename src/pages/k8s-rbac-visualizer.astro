<script>
import jsyaml from 'js-yaml';

// ─── TYPES ──────────────────────────────────────────────────────────────────

interface PolicyRule {
  apiGroups: string[];
  resources: string[];
  verbs: string[];
  resourceNames?: string[];
}
interface RoleObj { kind: 'Role'; name: string; namespace: string; rules: PolicyRule[]; }
interface ClusterRoleObj {
  kind: 'ClusterRole';
  name: string;
  rules: PolicyRule[];
  labels: Record<string, string>;
  aggregationRule?: { clusterRoleSelectors?: { matchLabels?: Record<string, string> }[] };
  effectiveRules?: PolicyRule[];
  unresolvedSelectors?: Record<string, string>[];
}
interface Subject { kind: string; name: string; namespace?: string; }
interface BindingObj {
  kind: 'RoleBinding' | 'ClusterRoleBinding';
  name: string;
  namespace?: string;
  roleRefKind: 'Role' | 'ClusterRole';
  roleRefName: string;
  subjects: Subject[];
}
interface ParseResult {
  roles: Map<string, RoleObj>;
  clusterRoles: Map<string, ClusterRoleObj>;
  roleBindings: BindingObj[];
  clusterRoleBindings: BindingObj[];
  errors: string[];
  warnings: string[];
}
interface Grant {
  subjectKey: string;
  subject: Subject;
  namespace: string;
  apiGroup: string;
  resource: string;
  verbs: string[];
  resourceNames?: string[];
  bindingKind: 'RoleBinding' | 'ClusterRoleBinding';
  bindingName: string;
  roleRefKind: 'Role' | 'ClusterRole';
  roleRefName: string;
}
interface DisplayRow {
  apiGroup: string;
  resource: string;
  verbs: Set<string>;
  resourceNames?: string[];
  bindings: { kind: string; name: string; roleRefKind: string; roleRefName: string }[];
}

// ─── HELPERS ────────────────────────────────────────────────────────────────

function escapeHtml(str: string): string {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function copyText(text: string, btn: HTMLElement) {
  function flash() {
    btn.classList.add('copied');
    const original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => { btn.classList.remove('copied'); btn.textContent = original; }, 1500);
  }
  function fallback() {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(flash).catch(() => { fallback(); flash(); });
  } else {
    fallback(); flash();
  }
}

// ─── PARSING ────────────────────────────────────────────────────────────────

function splitDocs(text: string): string[] {
  const lines = text.split(/\r?\n/);
  const docs: string[] = [];
  let current: string[] = [];
  for (const line of lines) {
    if (/^---\s*$/.test(line)) {
      docs.push(current.join('\n'));
      current = [];
    } else {
      current.push(line);
    }
  }
  docs.push(current.join('\n'));
  return docs.map((d) => d.trim()).filter((d) => d.length > 0);
}

function normalizeRule(r: any): PolicyRule | null {
  if (!r || typeof r !== 'object') return null;
  const apiGroups = Array.isArray(r.apiGroups) ? r.apiGroups.map(String) : [''];
  const resources = Array.isArray(r.resources) ? r.resources.map(String) : [];
  const verbs = Array.isArray(r.verbs) ? r.verbs.map(String) : [];
  const resourceNames = Array.isArray(r.resourceNames) && r.resourceNames.length ? r.resourceNames.map(String) : undefined;
  if (resources.length === 0 || verbs.length === 0) return null;
  return { apiGroups, resources, verbs, resourceNames };
}

function parseInput(text: string): ParseResult {
  const result: ParseResult = {
    roles: new Map(), clusterRoles: new Map(), roleBindings: [], clusterRoleBindings: [],
    errors: [], warnings: [],
  };
  const docs = splitDocs(text);

  docs.forEach((doc, i) => {
    let obj: any;
    try {
      obj = jsyaml.load(doc);
    } catch (e: any) {
      result.errors.push(`Document ${i + 1}: invalid YAML — ${e?.message || 'could not parse the input.'}`);
      return;
    }
    if (!obj || typeof obj !== 'object' || Array.isArray(obj)) {
      result.errors.push(`Document ${i + 1}: empty or not a YAML object, skipped.`);
      return;
    }
    const kind = obj.kind;
    if (!kind || !['Role', 'ClusterRole', 'RoleBinding', 'ClusterRoleBinding'].includes(kind)) {
      result.errors.push(`Document ${i + 1}: unrecognized or missing "kind" (${kind || 'none'}) — only Role, ClusterRole, RoleBinding and ClusterRoleBinding are supported, skipped.`);
      return;
    }
    const name = obj.metadata && obj.metadata.name;
    if (!name) {
      result.errors.push(`Document ${i + 1}: ${kind} is missing metadata.name, skipped.`);
      return;
    }

    if (kind === 'Role' || kind === 'ClusterRole') {
      const rulesRaw = Array.isArray(obj.rules) ? obj.rules : [];
      const rules = rulesRaw.map(normalizeRule).filter((r: PolicyRule | null): r is PolicyRule => !!r);
      if (kind === 'Role') {
        const namespace = obj.metadata && obj.metadata.namespace;
        const ns = namespace || 'default';
        if (!namespace) result.warnings.push(`Role "${name}" has no metadata.namespace — assuming "default".`);
        result.roles.set(`${ns}/${name}`, { kind: 'Role', name, namespace: ns, rules });
      } else {
        const labels = (obj.metadata && obj.metadata.labels) || {};
        result.clusterRoles.set(name, { kind: 'ClusterRole', name, rules, labels, aggregationRule: obj.aggregationRule });
      }
    } else {
      const roleRef = obj.roleRef;
      if (!roleRef || !roleRef.kind || !roleRef.name) {
        result.errors.push(`Document ${i + 1}: ${kind} "${name}" is missing a valid roleRef, skipped.`);
        return;
      }
      const subjectsRaw = Array.isArray(obj.subjects) ? obj.subjects : [];
      const subjects: Subject[] = subjectsRaw
        .map((s: any) => ({ kind: (s && s.kind) || 'User', name: s && s.name, namespace: s && s.namespace }))
        .filter((s: Subject) => !!s.name);
      if (subjects.length === 0) {
        result.warnings.push(`${kind} "${name}" has no valid subjects — it grants nothing.`);
      }
      if (kind === 'RoleBinding') {
        const namespace = obj.metadata && obj.metadata.namespace;
        const ns = namespace || 'default';
        if (!namespace) result.warnings.push(`RoleBinding "${name}" has no metadata.namespace — assuming "default".`);
        result.roleBindings.push({ kind: 'RoleBinding', name, namespace: ns, roleRefKind: roleRef.kind, roleRefName: roleRef.name, subjects });
      } else {
        if (roleRef.kind !== 'ClusterRole') {
          result.warnings.push(`ClusterRoleBinding "${name}" has roleRef.kind "${roleRef.kind}" — only ClusterRole is valid here, treating it as a ClusterRole reference.`);
        }
        result.clusterRoleBindings.push({ kind: 'ClusterRoleBinding', name, roleRefKind: 'ClusterRole', roleRefName: roleRef.name, subjects });
      }
    }
  });

  return result;
}

function resolveAggregation(result: ParseResult) {
  for (const cr of result.clusterRoles.values()) {
    const effective: PolicyRule[] = cr.rules.slice();
    const selectors = (cr.aggregationRule && cr.aggregationRule.clusterRoleSelectors) || [];
    const unresolved: Record<string, string>[] = [];

    for (const selector of selectors) {
      const matchLabels = selector.matchLabels || {};
      let matched = false;
      for (const other of result.clusterRoles.values()) {
        if (other.name === cr.name) continue;
        const isMatch = Object.entries(matchLabels).every(([k, v]) => other.labels && other.labels[k] === v);
        if (isMatch) {
          matched = true;
          effective.push(...other.rules);
        }
      }
      if (!matched) unresolved.push(matchLabels);
    }

    cr.effectiveRules = effective;
    cr.unresolvedSelectors = unresolved;
  }

  for (const cr of result.clusterRoles.values()) {
    if (cr.unresolvedSelectors && cr.unresolvedSelectors.length) {
      for (const sel of cr.unresolvedSelectors) {
        const selStr = Object.entries(sel).map(([k, v]) => `${k}=${v}`).join(', ') || '(empty selector)';
        result.warnings.push(`ClusterRole "${cr.name}" aggregates from ClusterRoles matching label ${selStr} — none found in your input, so its effective permissions shown here may be incomplete.`);
      }
    }
  }
}

function subjectKeyOf(s: Subject): string {
  if (s.kind === 'ServiceAccount') return `ServiceAccount:${s.namespace || 'default'}:${s.name}`;
  return `${s.kind}:${s.name}`;
}

function buildGrants(result: ParseResult): Grant[] {
  const grants: Grant[] = [];

  function pushGrants(rules: PolicyRule[], namespace: string, subjects: Subject[], bindingKind: 'RoleBinding' | 'ClusterRoleBinding', bindingName: string, roleRefKind: 'Role' | 'ClusterRole', roleRefName: string, bindingNamespace?: string) {
    for (const rawSubject of subjects) {
      let subject = rawSubject;
      if (subject.kind === 'ServiceAccount' && !subject.namespace) {
        if (bindingNamespace) {
          subject = { ...subject, namespace: bindingNamespace };
        } else {
          result.warnings.push(`Subject ServiceAccount "${subject.name}" in ${bindingKind} "${bindingName}" has no namespace — assuming "default".`);
          subject = { ...subject, namespace: 'default' };
        }
      }
      const subjectKey = subjectKeyOf(subject);
      for (const rule of rules) {
        for (const apiGroup of rule.apiGroups) {
          for (const resource of rule.resources) {
            grants.push({
              subjectKey, subject, namespace, apiGroup, resource,
              verbs: rule.verbs, resourceNames: rule.resourceNames,
              bindingKind, bindingName, roleRefKind, roleRefName,
            });
          }
        }
      }
    }
  }

  for (const rb of result.roleBindings) {
    let rules: PolicyRule[] = [];
    if (rb.roleRefKind === 'Role') {
      const role = result.roles.get(`${rb.namespace}/${rb.roleRefName}`);
      if (!role) {
        result.warnings.push(`RoleBinding "${rb.name}" references Role "${rb.roleRefName}" in namespace "${rb.namespace}" — not found in your input.`);
        continue;
      }
      rules = role.rules;
    } else {
      const cr = result.clusterRoles.get(rb.roleRefName);
      if (!cr) {
        result.warnings.push(`RoleBinding "${rb.name}" references ClusterRole "${rb.roleRefName}" — not found in your input.`);
        continue;
      }
      rules = cr.effectiveRules || cr.rules;
    }
    pushGrants(rules, rb.namespace!, rb.subjects, 'RoleBinding', rb.name, rb.roleRefKind, rb.roleRefName, rb.namespace);
  }

  for (const crb of result.clusterRoleBindings) {
    const cr = result.clusterRoles.get(crb.roleRefName);
    if (!cr) {
      result.warnings.push(`ClusterRoleBinding "${crb.name}" references ClusterRole "${crb.roleRefName}" — not found in your input.`);
      continue;
    }
    pushGrants(cr.effectiveRules || cr.rules, '*', crb.subjects, 'ClusterRoleBinding', crb.name, 'ClusterRole', crb.roleRefName);
  }

  return grants;
}

function groupGrants(grants: Grant[]): Map<string, { subject: Subject; byNamespace: Map<string, Map<string, DisplayRow>> }> {
  const bySubject = new Map<string, { subject: Subject; byNamespace: Map<string, Map<string, DisplayRow>> }>();

  for (const g of grants) {
    if (!bySubject.has(g.subjectKey)) bySubject.set(g.subjectKey, { subject: g.subject, byNamespace: new Map() });
    const subjEntry = bySubject.get(g.subjectKey)!;
    if (!subjEntry.byNamespace.has(g.namespace)) subjEntry.byNamespace.set(g.namespace, new Map());
    const nsMap = subjEntry.byNamespace.get(g.namespace)!;
    const rowKey = `${g.apiGroup}|${g.resource}|${(g.resourceNames || []).slice().sort().join(',')}`;
    if (!nsMap.has(rowKey)) {
      nsMap.set(rowKey, { apiGroup: g.apiGroup, resource: g.resource, verbs: new Set(), resourceNames: g.resourceNames, bindings: [] });
    }
    const row = nsMap.get(rowKey)!;
    g.verbs.forEach((v) => row.verbs.add(v));
    const sig = `${g.bindingKind}:${g.bindingName}`;
    if (!row.bindings.some((b) => `${b.kind}:${b.name}` === sig)) {
      row.bindings.push({ kind: g.bindingKind, name: g.bindingName, roleRefKind: g.roleRefKind, roleRefName: g.roleRefName });
    }
  }

  return bySubject;
}

// ─── RENDERING ──────────────────────────────────────────────────────────────

function renderRow(row: DisplayRow): string {
  const groupLabel = row.apiGroup === '' ? 'core' : row.apiGroup === '*' ? 'all API groups' : row.apiGroup;
  const resourceLabel = row.resource === '*' ? 'All resources (*)' : row.resource;
  const verbsArr = Array.from(row.verbs);
  const verbLabel = verbsArr.includes('*') ? 'All verbs (*)' : verbsArr.slice().sort().join(', ');
  const namesBadge = row.resourceNames && row.resourceNames.length
    ? `<span class="scope-badge">scoped to: ${row.resourceNames.map(escapeHtml).join(', ')}</span>`
    : '';

  const bindingsHtml = row.bindings.map((b) => {
    const gotchaNote = b.kind === 'RoleBinding' && b.roleRefKind === 'ClusterRole'
      ? `<span class="gotcha-inline" title="A RoleBinding to a ClusterRole grants namespace-scoped access only, never cluster-wide.">via ClusterRole — namespace-scoped only</span>`
      : '';
    return `<div class="grant-source">
      <code class="ic">${escapeHtml(b.kind)}/${escapeHtml(b.name)}</code>
      <span class="grant-arrow">&rarr;</span>
      <code class="ic">${escapeHtml(b.roleRefKind)}/${escapeHtml(b.roleRefName)}</code>
      ${gotchaNote}
    </div>`;
  }).join('');

  return `<div class="perm-row">
    <div class="perm-row-head">
      <code class="perm-resource">${escapeHtml(groupLabel)}/${escapeHtml(resourceLabel)}</code>
      <span class="perm-verbs">${escapeHtml(verbLabel)}</span>
      ${namesBadge}
    </div>
    <div class="perm-why">
      <p class="why-label">Granted by</p>
      ${bindingsHtml}
    </div>
  </div>`;
}

function renderSubject(entry: { subject: Subject; byNamespace: Map<string, Map<string, DisplayRow>> }): string {
  const { subject, byNamespace } = entry;
  const nsKeys = Array.from(byNamespace.keys()).sort((a, b) => (a === '*' ? -1 : b === '*' ? 1 : a.localeCompare(b)));
  let totalPerms = 0;
  byNamespace.forEach((nsMap) => (totalPerms += nsMap.size));

  const nsBlocks = nsKeys.map((ns) => {
    const nsMap = byNamespace.get(ns)!;
    const nsLabel = ns === '*' ? 'Cluster-wide (all namespaces)' : `Namespace: ${ns}`;
    const rows = Array.from(nsMap.values())
      .sort((a, b) => (a.apiGroup + a.resource).localeCompare(b.apiGroup + b.resource))
      .map(renderRow)
      .join('');
    return `<div class="ns-block"><p class="ns-label">${escapeHtml(nsLabel)}</p>${rows}</div>`;
  }).join('');

  const subjectLabel = subject.kind === 'ServiceAccount'
    ? `${escapeHtml(subject.name)} <span class="subject-ns">(ns: ${escapeHtml(subject.namespace || 'default')})</span>`
    : escapeHtml(subject.name);

  const searchBlob = `${subject.name} ${subject.kind}`.toLowerCase();

  return `<div class="subject-card" data-search="${escapeHtml(searchBlob)}">
    <button class="subject-toggle" aria-expanded="false">
      <span class="subject-kind-badge subject-kind-${escapeHtml(subject.kind)}">${escapeHtml(subject.kind)}</span>
      <span class="subject-info">
        <span class="subject-name">${subjectLabel}</span>
        <span class="subject-count"> — ${totalPerms} permission${totalPerms === 1 ? '' : 's'}</span>
      </span>
      <svg class="subject-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="subject-panel"><div class="subject-panel-inner">${nsBlocks}</div></div>
  </div>`;
}

// ─── PERMALINK ENCODING ─────────────────────────────────────────────────────

function base64UrlEncode(bytes: Uint8Array): string {
  let binary = '';
  bytes.forEach((b) => (binary += String.fromCharCode(b)));
  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
function base64UrlDecode(str: string): Uint8Array {
  let s = str.replace(/-/g, '+').replace(/_/g, '/');
  while (s.length % 4) s += '=';
  const binary = atob(s);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

async function encodeStateToParam(text: string): Promise<string> {
  const bytes = new TextEncoder().encode(text);
  if (typeof (window as any).CompressionStream !== 'undefined') {
    try {
      const cs = new (window as any).CompressionStream('gzip');
      const writer = cs.writable.getWriter();
      writer.write(bytes);
      writer.close();
      const compressed = await new Response(cs.readable).arrayBuffer();
      return 'gz.' + base64UrlEncode(new Uint8Array(compressed));
    } catch { /* fall through to plain base64 */ }
  }
  return 'b64.' + base64UrlEncode(bytes);
}

async function decodeStateFromParam(param: string): Promise<string | null> {
  const sepIdx = param.indexOf('.');
  if (sepIdx === -1) return null;
  const tag = param.slice(0, sepIdx);
  const data = param.slice(sepIdx + 1);
  if (!data) return null;
  const bytes = base64UrlDecode(data);
  if (tag === 'gz' && typeof (window as any).DecompressionStream !== 'undefined') {
    try {
      const ds = new (window as any).DecompressionStream('gzip');
      const writer = ds.writable.getWriter();
      writer.write(bytes);
      writer.close();
      const decompressed = await new Response(ds.readable).arrayBuffer();
      return new TextDecoder('utf-8').decode(decompressed);
    } catch { return null; }
  }
  if (tag === 'b64') return new TextDecoder('utf-8').decode(bytes);
  return null;
}

// ─── WIRING ─────────────────────────────────────────────────────────────────

const input = document.getElementById('rbacInput') as HTMLTextAreaElement;
const visualizeBtn = document.getElementById('visualizeBtn') as HTMLButtonElement;
const loadExampleBtn = document.getElementById('loadExampleBtn') as HTMLButtonElement;
const copyLinkBtn = document.getElementById('copyLinkBtn') as HTMLButtonElement;
const errorBox = document.getElementById('rbacError') as HTMLDivElement;
const warnBox = document.getElementById('rbacWarning') as HTMLDivElement;
const resultsCard = document.getElementById('resultsCard') as HTMLDivElement;
const resultsBody = document.getElementById('resultsBody') as HTMLDivElement;
const noResults = document.getElementById('noResults') as HTMLDivElement;
const subjectSearch = document.getElementById('subjectSearch') as HTMLInputElement;

const EXAMPLE_YAML = `apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: pod-reader
  namespace: staging
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get"]
    resourceNames: ["app-config"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: pod-reader-binding
  namespace: staging
subjects:
  - kind: ServiceAccount
    name: staging-app
    namespace: staging
roleRef:
  kind: Role
  name: pod-reader
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: secret-admin-cluster
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["*"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: secret-admin-in-staging
  namespace: staging
subjects:
  - kind: User
    name: alice@example.com
roleRef:
  kind: ClusterRole
  name: secret-admin-cluster
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: monitoring-aggregate
  labels:
    rbac.example.com/aggregate-to-monitoring: "true"
aggregationRule:
  clusterRoleSelectors:
    - matchLabels:
        rbac.example.com/aggregate-to-monitoring: "true"
rules: []
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: metrics-reader
  labels:
    rbac.example.com/aggregate-to-monitoring: "true"
rules:
  - apiGroups: ["metrics.k8s.io"]
    resources: ["pods", "nodes"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: monitoring-team-binding
subjects:
  - kind: Group
    name: monitoring-team
roleRef:
  kind: ClusterRole
  name: monitoring-aggregate
  apiGroup: rbac.authorization.k8s.io
`;

function wireAccordions() {
  resultsBody.querySelectorAll('.subject-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.parentElement!.querySelector('.subject-panel') as HTMLElement;
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      panel.classList.toggle('expanded', !isExpanded);
    });
  });
}

function runVisualize() {
  errorBox.classList.add('hidden'); errorBox.innerHTML = '';
  warnBox.classList.add('hidden'); warnBox.innerHTML = '';
  resultsCard.classList.add('hidden');
  resultsBody.innerHTML = '';

  const raw = input.value;
  if (!raw.trim()) return;

  const result = parseInput(raw);
  resolveAggregation(result);
  const grants = buildGrants(result);

  if (result.errors.length) {
    errorBox.innerHTML = result.errors.map((e) => `<div>${escapeHtml(e)}</div>`).join('');
    errorBox.classList.remove('hidden');
  }
  if (result.warnings.length) {
    warnBox.innerHTML = result.warnings.map((w) => `<div>${escapeHtml(w)}</div>`).join('');
    warnBox.classList.remove('hidden');
  }

  if (grants.length === 0) return;

  const bySubject = groupGrants(grants);
  const subjectsArr = Array.from(bySubject.values()).sort((a, b) => a.subject.name.localeCompare(b.subject.name));
  resultsBody.innerHTML = subjectsArr.map(renderSubject).join('');
  wireAccordions();

  subjectSearch.value = '';
  noResults.classList.add('hidden');

  resultsCard.classList.remove('hidden');
  if ((window as any).showKofiPrompt) (window as any).showKofiPrompt();
}

visualizeBtn.addEventListener('click', runVisualize);

loadExampleBtn.addEventListener('click', () => {
  input.value = EXAMPLE_YAML;
  runVisualize();
});

copyLinkBtn.addEventListener('click', async () => {
  if (!input.value.trim()) return;
  const param = await encodeStateToParam(input.value);
  const url = new URL(window.location.href);
  url.search = '';
  url.searchParams.set('y', param);
  copyText(url.toString(), copyLinkBtn);
});

subjectSearch.addEventListener('input', () => {
  const q = subjectSearch.value.trim().toLowerCase();
  const cards = Array.from(resultsBody.querySelectorAll('.subject-card')) as HTMLElement[];
  let visible = 0;
  cards.forEach((card) => {
    const matches = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
    card.style.display = matches ? '' : 'none';
    if (matches) visible++;
  });
  noResults.classList.toggle('hidden', visible !== 0 || cards.length === 0);
});

// ─── FAQ ACCORDION ───────────────────────────────────────────────────────────

document.querySelectorAll('.faq-trigger').forEach((btn) => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item') as HTMLElement;
    const content = item.querySelector('.faq-content') as HTMLElement;
    const chevron = btn.querySelector('.faq-chevron') as HTMLElement;
    const isOpen = !content.classList.contains('hidden');
    content.classList.toggle('hidden', isOpen);
    (chevron as HTMLElement).style.transform = isOpen ? '' : 'rotate(180deg)';
  });
});

// ─── PERMALINK LOAD-ON-BOOT ──────────────────────────────────────────────────

(async () => {
  const params = new URLSearchParams(window.location.search);
  const y = params.get('y');
  if (!y) return;
  const decoded = await decodeStateFromParam(y);
  if (decoded) {
    input.value = decoded;
    runVisualize();
  }
})();
</script>

</Layout>
