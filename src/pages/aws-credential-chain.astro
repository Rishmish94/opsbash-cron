<script>
function copyText(text: string, btn: HTMLElement) {
  function flash() {
    btn.classList.add('copied');
    const original = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.textContent = original;
    }, 1400);
  }
  function fallback() {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(flash).catch(() => { fallback(); flash(); });
  } else {
    fallback(); flash();
  }
}

// ── Credential chain step accordion ──────────────────────────────────────
document.querySelectorAll('.chain-step-toggle').forEach((btn) => {
  btn.addEventListener('click', () => {
    const panelId = btn.getAttribute('data-panel');
    if (!panelId) return;
    const panel = document.getElementById(panelId);
    if (!panel) return;
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    panel.classList.toggle('expanded', !isExpanded);
  });
});

// ── Copy buttons ──────────────────────────────────────────────────────────
document.querySelectorAll('.copy-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    const text = btn.getAttribute('data-copy') || '';
    if (text) copyText(text, btn as HTMLElement);
  });
});

// ── FAQ accordion ──────────────────────────────────────────────────────────
document.querySelectorAll('.faq-trigger').forEach((btn) => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item') as HTMLElement;
    const content = item.querySelector('.faq-content') as HTMLElement;
    const chevron = btn.querySelector('.faq-chevron') as HTMLElement;
    const isOpen = !content.classList.contains('hidden');
    content.classList.toggle('hidden', isOpen);
    chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
  });
});

// ── Interactive decision tree ────────────────────────────────────────────
interface DtOption { label: string; next: string; }
interface DtQuestion { question: string; options: DtOption[]; }
interface DtDiagnosis { diagnosis: string; fix: string; }

const tree: Record<string, DtQuestion> = {
  start: {
    question: 'Are you getting an error or using the wrong account?',
    options: [
      { label: 'Getting an error', next: 'q2a' },
      { label: 'Using wrong account', next: 'q2b' },
    ],
  },
  q2a: {
    question: 'What error are you seeing?',
    options: [
      { label: 'Unable to locate credentials', next: 'd1' },
      { label: 'ExpiredToken or TokenRefreshRequired', next: 'd2' },
      { label: 'InvalidClientTokenId', next: 'd3' },
      { label: 'Access Denied or not authorized', next: 'd4' },
    ],
  },
  q2b: {
    question: 'How are you running the command?',
    options: [
      { label: 'Plain aws command with no flags', next: 'd5' },
      { label: 'With --profile flag', next: 'd6' },
      { label: 'In a script or application', next: 'd7' },
    ],
  },
};

const diagnoses: Record<string, DtDiagnosis> = {
  d1: { diagnosis: 'AWS found no credentials in any of the 6 sources. Start from Step 1 and work down.', fix: 'aws configure list' },
  d2: { diagnosis: 'You have temporary credentials from an assumed role or SSO session that have expired.', fix: 'aws sso login --profile yourprofile OR unset AWS_SESSION_TOKEN and use long-term credentials' },
  d3: { diagnosis: 'Your access key ID is invalid or has been deleted.', fix: 'aws configure list to see which key is being used, then check IAM console' },
  d4: { diagnosis: 'Your credentials are valid but the IAM identity does not have permission for this action.', fix: 'aws sts get-caller-identity to confirm which identity you are using' },
  d5: { diagnosis: 'AWS is using whichever credential source wins based on the precedence order above. Check environment variables first.', fix: 'aws configure list' },
  d6: { diagnosis: 'AWS is using the profile you specified. The issue is in that profile\'s configuration.', fix: 'aws configure list --profile yourprofile' },
  d7: { diagnosis: 'The script is likely inheriting environment variables or using an instance role. Check what AWS_ environment variables are set.', fix: 'env | grep AWS_' },
};

const dtRoot = document.getElementById('dtRoot') as HTMLDivElement;
const dtReset = document.getElementById('dtReset') as HTMLButtonElement;
let dtPath: string[] = [];

function escapeHtml(str: string): string {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderNode(key: string) {
  if (tree[key]) {
    const node = tree[key];
    dtRoot.innerHTML = `
      ${dtPath.length ? `<p class="dt-breadcrumb">Question ${dtPath.length + 1}</p>` : ''}
      <p class="dt-question">${escapeHtml(node.question)}</p>
      <div class="dt-options">
        ${node.options.map((o) => `<button class="dt-btn" data-next="${o.next}">${escapeHtml(o.label)}</button>`).join('')}
      </div>
    `;
    dtRoot.querySelectorAll('.dt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('data-next');
        if (!next) return;
        dtPath.push(next);
        renderNode(next);
      });
    });
    dtReset.classList.toggle('hidden', dtPath.length === 0);
  } else if (diagnoses[key]) {
    const d = diagnoses[key];
    dtRoot.innerHTML = `
      <p class="dt-diagnosis-title">What is likely happening</p>
      <p class="dt-diagnosis-text">${escapeHtml(d.diagnosis)}</p>
      <p class="dt-fix-title">Fix</p>
      <div class="cmd-block" style="margin-top: 4px;">
        <code class="cmd-text">${escapeHtml(d.fix)}</code>
        <button class="copy-btn" data-copy="${escapeHtml(d.fix)}">Copy</button>
      </div>
    `;
    const copyBtn = dtRoot.querySelector('.copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = copyBtn.getAttribute('data-copy') || '';
        if (text) copyText(text, copyBtn as HTMLElement);
      });
    }
    dtReset.classList.remove('hidden');
    if ((window as any).showKofiPrompt) (window as any).showKofiPrompt();
  }
}

dtReset.addEventListener('click', () => {
  dtPath = [];
  renderNode('start');
});

renderNode('start');
</script>

</Layout>
